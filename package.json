{
  "name": "lol-dps-sim",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm --filter @lol/web dev",
    "build": "pnpm --filter @lol/web build",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "scenarios:check": "node scripts/check-scenarios.ts",
    "data:update": "tsx packages/data-pipeline/src/cli.ts",
    "format": "prettier --write .",
    "test:e2e": "pnpm --filter @lol/web test:e2e",
    "mutate": "stryker run",
    "mutate:changed": "node scripts/mutate-changed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/api": "^10.1.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "~4.1.12"
  }
}
